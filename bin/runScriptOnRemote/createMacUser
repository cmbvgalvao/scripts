#!/bin/bash
# Payload for runOnHosts: create a local STANDARD (non-admin) account, then
# restart the Mac.
#
# Fill in a COPY of this file named createMacUser.local (ignored by git, so the
# password never reaches this public repo), then run the copy with runOnHosts.

LOCAL_FULLNAME=""    # full name, e.g. "Student"
LOCAL_SHORTNAME=""   # account (short) name
LOCAL_PASSWORD=""    # password

if [ -z "$LOCAL_SHORTNAME" ] || [ -z "$LOCAL_PASSWORD" ]; then
  echo "Fill in the account details in a .local copy of this script first." >&2
  exit 1
fi

sudo sysadminctl -addUser "$LOCAL_SHORTNAME" \
  -fullName "$LOCAL_FULLNAME" \
  -password "$LOCAL_PASSWORD"
sudo reboot now
