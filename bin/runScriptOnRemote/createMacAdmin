#!/bin/bash
# Fill in a COPY of this file named createMacAdmin.local (ignored by git, so the
# password never reaches this public repo), then run the copy with runOnHosts.
LOCAL_ADMIN_FULLNAME=""     # The local admin user's full name
LOCAL_ADMIN_SHORTNAME=""     # The local admin user's shortname
LOCAL_ADMIN_PASSWORD=""      # The local admin user's password

# Create a local admin user account
if [ -z "$LOCAL_ADMIN_SHORTNAME" ] || [ -z "$LOCAL_ADMIN_PASSWORD" ]; then
  echo "Fill in the account details in a .local copy of this script first." >&2
  exit 1
fi
sudo sysadminctl -addUser "$LOCAL_ADMIN_SHORTNAME" -fullName "$LOCAL_ADMIN_FULLNAME" -password "$LOCAL_ADMIN_PASSWORD" -admin
sudo reboot now
