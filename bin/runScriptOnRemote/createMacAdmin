#!/bin/bash
# Payload for runOnHosts: create a local ADMIN account, then restart the Mac.
#
# Fill in a COPY of this file named createMacAdmin.local (ignored by git, so the
# password never reaches this public repo), then run the copy with runOnHosts.

LOCAL_ADMIN_FULLNAME=""    # full name, e.g. "Classroom Admin"
LOCAL_ADMIN_SHORTNAME=""   # account (short) name
LOCAL_ADMIN_PASSWORD=""    # password

if [ -z "$LOCAL_ADMIN_SHORTNAME" ] || [ -z "$LOCAL_ADMIN_PASSWORD" ]; then
  echo "Fill in the account details in a .local copy of this script first." >&2
  exit 1
fi

sudo sysadminctl -addUser "$LOCAL_ADMIN_SHORTNAME" \
  -fullName "$LOCAL_ADMIN_FULLNAME" \
  -password "$LOCAL_ADMIN_PASSWORD" \
  -admin
sudo reboot now
