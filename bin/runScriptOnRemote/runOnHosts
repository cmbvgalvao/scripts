#!/bin/bash
# Run a local script on every machine listed in a CSV file, over SSH.
#
# Usage: runOnHosts <hosts.csv> <script>
#   hosts.csv  one "username,hostname" pair per line; a "username,hostname"
#              header line and blank lines are skipped
#   script     a local script, e.g. createMacUser.local or installVscode

CSV_FILE=$1
REMOTE_SCRIPT=$2

if [ ! -f "$CSV_FILE" ]; then
  echo "CSV file not found: $CSV_FILE"
  exit 1
fi

# Pipe the script into "bash -s" on one host and report how it went.
run_on_host() {
  local username=$1 hostname=$2

  echo "Connecting to $hostname as $username..."
  if ssh "$username@$hostname" "bash -s" < "$REMOTE_SCRIPT"; then
    echo "Successfully executed script on $hostname"
  else
    echo "Failed to execute script on $hostname"
  fi
}

while IFS=, read -r username hostname; do
  hostname=${hostname%$'\r'}    # CSV files saved on Windows end each line with \r

  [ -z "$username" ] && continue                                 # blank line
  [ "$username,$hostname" = "username,hostname" ] && continue    # header line

  run_on_host "$username" "$hostname"
done < "$CSV_FILE"
