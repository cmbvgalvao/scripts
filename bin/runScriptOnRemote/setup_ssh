#!/bin/bash
# Authorise an SSH public key for the current user, so runOnHosts can log in
# without a password. Works on macOS and Linux.
#
# Usage: setup_ssh <path_to_public_key>

PUBLIC_KEY_PATH=$1

if [ -z "$PUBLIC_KEY_PATH" ]; then
  echo "Usage: $0 <path_to_public_key>"
  exit 1
fi

if [ ! -f "$PUBLIC_KEY_PATH" ]; then
  echo "Error: Public key file '$PUBLIC_KEY_PATH' does not exist."
  exit 2
fi

SSH_DIR="$HOME/.ssh"
AUTHORIZED_KEYS="$SSH_DIR/authorized_keys"

mkdir -p "$SSH_DIR"
cat "$PUBLIC_KEY_PATH" >> "$AUTHORIZED_KEYS"

# sshd ignores keys whose files are too open or owned by someone else
chmod 700 "$SSH_DIR"
chmod 600 "$AUTHORIZED_KEYS"
chown -R "$(id -un):$(id -gn)" "$SSH_DIR"

echo "Public key has been added to authorized_keys with correct permissions."
