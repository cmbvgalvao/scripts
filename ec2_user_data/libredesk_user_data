#!/bin/bash

# Fill these in before launching the instance.
# DOMAIN must already point at the server (A record) for HTTPS to be set up.
DOMAIN=""                      # e.g. help.example.com
CERT_EMAIL=""                  # for Let's Encrypt expiry notices
LIBREDESK_VERSION="v2.9.2"     # a release tag, not main

# 1. Set non-interactive mode
export DEBIAN_FRONTEND=noninteractive

# 2. Update and Upgrade
echo "--- Starting System Update ---"
apt-get update -y && apt-get upgrade -y

# 3. Install Fail2ban
echo "--- Installing Fail2ban ---"
apt-get install -y fail2ban
cp /etc/fail2ban/jail.conf /etc/fail2ban/jail.local
systemctl start fail2ban
systemctl enable fail2ban

# 4. Install Docker Engine
echo "--- Installing Docker ---"
apt-get install -y ca-certificates curl gnupg
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
  tee /etc/apt/sources.list.d/docker.list > /dev/null

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

systemctl enable docker
systemctl start docker
usermod -aG docker ubuntu

# 5. Install Nginx and Certbot
echo "--- Installing Nginx & Certbot ---"
apt-get install -y nginx python3-certbot-nginx

# 6. Configure Nginx Reverse Proxy
# We create a config that listens on Port 80 and forwards to Docker Port 9000
cat <<EOF > /etc/nginx/sites-available/libredesk
server {
    listen 80;
    server_name ${DOMAIN:-_};

    location / {
        proxy_pass http://localhost:9000;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
EOF

# Enable the configuration and remove the default
ln -s /etc/nginx/sites-available/libredesk /etc/nginx/sites-enabled/
rm /etc/nginx/sites-enabled/default

# Test and Restart Nginx
nginx -t
systemctl restart nginx

# 7. Deploy LibreDesk
echo "--- Deploying LibreDesk ---"
mkdir -p /opt/libredesk
cd /opt/libredesk || exit 1

# Pinned release, not the moving main branch
curl -fLO "https://github.com/abhinavxd/libredesk/raw/${LIBREDESK_VERSION}/docker-compose.yml"
curl -fLO "https://github.com/abhinavxd/libredesk/raw/${LIBREDESK_VERSION}/config.sample.toml"
cp config.sample.toml config.toml

# Same image version as the files, and the app reachable only through nginx
sed -i "s#libredesk/libredesk:latest#libredesk/libredesk:${LIBREDESK_VERSION}#" docker-compose.yml
sed -i 's#"9000:9000"#"127.0.0.1:9000:9000"#' docker-compose.yml

# Fresh secrets instead of the sample's published ones
DB_PASSWORD=$(openssl rand -hex 24)
ADMIN_PASSWORD=$(openssl rand -base64 18)
sed -i "s#^encryption_key = .*#encryption_key = \"$(openssl rand -hex 16)\"#" config.toml
sed -i "s#^password = \"libredesk\"#password = \"${DB_PASSWORD}\"#" config.toml
printf 'POSTGRES_PASSWORD=%s\nLIBREDESK_SYSTEM_USER_PASSWORD=%s\n' "$DB_PASSWORD" "$ADMIN_PASSWORD" > .env
chmod 600 config.toml .env
echo "$ADMIN_PASSWORD" > /root/libredesk-admin-password.txt
chmod 600 /root/libredesk-admin-password.txt

docker compose up -d

# 8. HTTPS
if [ -n "$DOMAIN" ] && [ -n "$CERT_EMAIL" ]; then
  echo "--- Requesting a certificate for $DOMAIN ---"
  certbot --nginx -d "$DOMAIN" --non-interactive --agree-tos -m "$CERT_EMAIL" --redirect
else
  echo "--- DOMAIN/CERT_EMAIL not set: serving plain HTTP. Run certbot --nginx later. ---"
fi
echo "Admin (System user) password saved in /root/libredesk-admin-password.txt"

echo "--- User Data Script Completed Successfully ---"
